rules_version = '2';

// Firestore security rules for the planner. Paste these into the Firebase
// console (Firestore Database > Rules) and click Publish; this copy is kept
// here so the rules are versioned with the code.
//
// Each account's data is one document, users/{uid}. Only the owner's
// account (the passphrase account's UID, from Authentication > Users) may
// read or write it, and every other path is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && userId == "JFecCAUCusUKqdXy4SxePfEKLdm1";
    }
  }
}
